# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la plantilla, que no lleva claves y a la que apuntan README y docs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ProjectNotes
/.projectnotes/

# Paquete standalone: salida de build (`npm run build:standalone`).
# Lleva node_modules dentro, así que se genera, no se versiona.
/standalone/
